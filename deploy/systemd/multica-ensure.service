# Self-heal check: start only what is down. Installed by
# `./start.sh autostart on` from deploy/systemd/multica-ensure.service.
#
# TEMPLATE, not a ready-to-install unit: @ROOT@/@USER@/@PATH@ are rendered at
# install time. See multica.service for the full placeholder set.
[Unit]
Description=Multica self-heal check (start what is down)
Documentation=file://@ROOT@/start.sh
# A user-scope install drops the User=/Group= pair below.
After=network-online.target multica.service
Wants=network-online.target

[Service]
Type=oneshot
# Required, and not a copy-paste from multica.service: this unit starts the CLI
# daemon, and without RemainAfterExit systemd tears the unit down the moment
# `start.sh ensure` exits 0 — SIGTERMing every process still in the control
# group. `multica daemon start` detaches with Setsid, which moves the child to
# a new session and process group but leaves it in this unit's cgroup, so the
# daemon it had just reported as started was killed a few hundred milliseconds
# later. The self-heal timer then restarted it every tick, so recovery never
# stuck. Drop this line and the daemon dies with the unit again.
RemainAfterExit=yes
# Dropped when this is installed as a user unit.
User=@USER@
Group=@GROUP@
WorkingDirectory=@ROOT@
Environment=HOME=@HOME@
Environment=SHELL=/bin/bash
# Same reason as in multica.service: the timer runs the same script from a
# non-interactive unit, so it needs the CLI / Go / Node dirs on PATH.
Environment=PATH=@PATH@
ExecStart=@ROOT@/start.sh ensure
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal
SyslogIdentifier=multica-ensure
