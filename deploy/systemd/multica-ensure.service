# Self-heal check: start only what is down. Installed by
# `./start.sh autostart on` from deploy/systemd/multica-ensure.service.
#
# TEMPLATE, not a ready-to-install unit: @ROOT@/@USER@/@PATH@ are rendered at
# install time. See multica.service for the full placeholder set.
[Unit]
Description=Multica self-heal check (start what is down)
Documentation=file://@ROOT@/start.sh
# A user-scope install drops the User=/Group= pair below.
After=network-online.target multica.service
Wants=network-online.target

[Service]
Type=oneshot
# Dropped when this is installed as a user unit.
User=@USER@
Group=@GROUP@
WorkingDirectory=@ROOT@
Environment=HOME=@HOME@
Environment=SHELL=/bin/bash
# Same reason as in multica.service: the timer runs the same script from a
# non-interactive unit, so it needs the CLI / Go / Node dirs on PATH.
Environment=PATH=@PATH@
ExecStart=@ROOT@/start.sh ensure
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal
SyslogIdentifier=multica-ensure
