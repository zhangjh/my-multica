# Long-lived immutable assets built with content hashes can be cached hard
# at the Cloudflare edge when served from the Worker's assets binding.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# favicons and site asset bundles get a short cache so deploys don't leave
# stale icons behind.
/favicon.svg
  Cache-Control: public, max-age=3600